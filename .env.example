# ── MTTR-A environment configuration ─────────────────────────────────────────
# Copy this file to .env and fill in values for your chosen provider.
# All variables are loaded automatically by load_from_env() — no `export` needed.
# Platform-injected secrets (Kubernetes, ECS, Cloud Run) always take precedence.

# ── Provider selection ────────────────────────────────────────────────────────
# Options: mock | bedrock | azure_openai | vertex_ai
MTTR_PROVIDER=mock

# ── Benchmark tuning ──────────────────────────────────────────────────────────
MTTR_N_RUNS=200
MTTR_SEED=42
MTTR_DRIFT_THRESHOLD=0.6         # τ_drift — confidence below this flags drift
MTTR_STOCHASTIC_FAULT_RATE=0.05  # random fault injection rate (5%)
MTTR_MTBF_MEAN=6.73              # Exponential mean for stable intervals (seconds)
MTTR_ALPHA=0.90                  # Confidence level for NRR_α (Cantelli bound)
MTTR_VERBOSE=true

# ── Output paths ──────────────────────────────────────────────────────────────
MTTR_TELEMETRY_PATH=telemetry.jsonl
MTTR_RESULTS_PATH=results.json

# ── LLM settings (apply to all real providers) ────────────────────────────────
MTTR_TEMPERATURE=0.0
MTTR_MAX_TOKENS=512

# ── Telemetry sinks ───────────────────────────────────────────────────────────
# JSONL (MTTR_TELEMETRY_PATH) is always written.
# Enable any combination of cloud sinks below.

# AWS CloudWatch Metrics
MTTR_SINK_CLOUDWATCH=false
MTTR_CLOUDWATCH_NAMESPACE=MTTR-A

# Azure Monitor / Application Insights
MTTR_SINK_AZURE_MONITOR=false
APPLICATIONINSIGHTS_CONNECTION_STRING=

# GCP Cloud Logging  (uses MTTR_GCP_PROJECT defined below)
MTTR_SINK_GCP_LOGGING=false

# ─────────────────────────────────────────────────────────────────────────────
# AWS Bedrock
# Install: pip install -e ".[bedrock]"
# Auth:    IAM role | IRSA (EKS) | env vars below | ~/.aws/credentials
# ─────────────────────────────────────────────────────────────────────────────
# MTTR_PROVIDER=bedrock
# MTTR_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# MTTR_AWS_REGION=us-east-1
#
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...          # only if using temporary credentials

# ─────────────────────────────────────────────────────────────────────────────
# Azure OpenAI
# Install: pip install -e ".[azure]"
# Auth:    AZURE_OPENAI_API_KEY  |  DefaultAzureCredential (managed identity)
# ─────────────────────────────────────────────────────────────────────────────
# MTTR_PROVIDER=azure_openai
# MTTR_AZURE_ENDPOINT=https://my-resource.openai.azure.com
# MTTR_AZURE_DEPLOYMENT=gpt-4o
# MTTR_AZURE_API_VERSION=2024-02-01
#
# AZURE_OPENAI_API_KEY=...

# ─────────────────────────────────────────────────────────────────────────────
# GCP Vertex AI
# Install: pip install -e ".[vertex]"
# Auth:    gcloud auth application-default login  |  GOOGLE_APPLICATION_CREDENTIALS
# ─────────────────────────────────────────────────────────────────────────────
# MTTR_PROVIDER=vertex_ai
# MTTR_GCP_PROJECT=my-gcp-project
# MTTR_GCP_LOCATION=us-central1
# MTTR_MODEL_ID=gemini-1.5-pro-002
#
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─────────────────────────────────────────────────────────────────────────────
# Mock-only settings (ignored when using a real provider)
# ─────────────────────────────────────────────────────────────────────────────
MTTR_MOCK_LATENCY=false   # set true to simulate realistic LLM call durations
